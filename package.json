{
  "name": "heybox-daily",
  "version": "0.1.0",
  "private": true,
  "description": "小黑盒每日签到和分享任务",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "pnpm build && node dist/cli.js check",
    "start": "pnpm build && node dist/cli.js run",
    "test": "pnpm build && node --test test/*.test.js"
  },
  "license": "MIT",
  "packageManager": "pnpm@12.15.0",
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "playwright-core": "1.64.1"
  }
}
