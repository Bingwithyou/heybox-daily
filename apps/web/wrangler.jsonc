{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "heybox-daily",
  "account_id": "b844e50c43f36e313952cf13a4dafca7",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-26",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "routes": [{ "pattern": "heybox.cansiny.top", "custom_domain": true }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "heybox-daily",
      "database_id": "b70ffb01-5c23-4971-9b48-0ad92f47e6f6",
      "migrations_dir": "migrations",
    },
  ],
  "triggers": { "crons": ["1 * * * *"] },
  "vars": {
    "SITE_URL": "https://heybox.cansiny.top",
    "RUNNER_URL": "https://heybox-runner.cansiny.top",
  },
}
