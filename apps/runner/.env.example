WEBSITE_URL=https://heybox.cansiny.top
# Same service token as the Worker. Generate with: openssl rand -hex 32
RUNNER_SERVICE_TOKEN=
# Only the VPS holds this key. Generate with: openssl rand -base64 32
CREDENTIAL_KEY=
# Daily task concurrency (1–8). Set 1 to restore serial execution.
TASK_CONCURRENCY=8
# Optional, verified public outbound IP. Update after NAT/proxy changes; not auto-detected.
RUNNER_EGRESS_IP=
# Optional pair: route hosted login through a dedicated Worker; leave both empty for direct access.
LOGIN_RELAY_URL=
LOGIN_RELAY_TOKEN=
